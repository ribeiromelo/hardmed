{
  "name": "hardmedicina",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run dev:sandbox",
    "dev:sandbox": "wrangler pages dev dist --d1=hardmedicina-production --local --ip 0.0.0.0 --port 3000",
    "build": "npm run build:styles && vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name hardmedicina",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply hardmedicina-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply hardmedicina-production",
    "db:seed": "wrangler d1 execute hardmedicina-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "tsx --test tests/auth.test.ts tests/security.integration.test.ts",
    "build:styles": "tailwindcss -c tailwind.app.cjs -i ./src/app-utilities.css -o ./public/static/app-utilities.css --minify"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "vite": "^6.4.6",
    "wrangler": "^4.166.0"
  }
}
